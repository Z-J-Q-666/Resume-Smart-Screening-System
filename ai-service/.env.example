# 复制为 .env 后填入自己的配置（.env 已被 .gitignore 忽略，不要提交真实 key）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0

MAX_TEXT_CHARS=8000
MIN_TEXT_CHARS=60

# ---- 可选：向量化服务 ----
# 用于语义分校准的"相似历史录用者"检索。三项任一为空即视为不可用，
# 系统自动降级为「技能 Jaccard + 年限接近度 + 学历一致」的本地相似度，功能不受影响。
#
# 本地 Ollama（推荐，无需联网）：
#   ollama pull bge-m3
#   EMBED_BASE_URL=http://127.0.0.1:11434/v1
#   EMBED_API_KEY=ollama            # Ollama 不校验，随便填
#   EMBED_MODEL=bge-m3              # 1024 维，中文效果好
#
# 云端（阿里百炼）：
#   EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBED_API_KEY=sk-xxx
#   EMBED_MODEL=text-embedding-v3
#
# 注意：容器部署时 Ollama 在宿主机上，地址要改成 host.docker.internal:11434，
# 写 127.0.0.1 指的是容器自己，连不上。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
