# 复制为 .env（同目录），docker compose 会自动读取。
# .env 已被 .gitignore 忽略，不会提交。

# ---- 必填：LLM ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-请换成你自己的key
LLM_MODEL=deepseek-chat

# ---- 可选：端口与密码 ----
# 对外只暴露前端一个端口，其它端口仅供本机调试，服务器上可以删掉对应的 ports
WEB_PORT=8088
MYSQL_PORT=3306
REDIS_PORT=6379
MYSQL_ROOT_PASSWORD=123456
